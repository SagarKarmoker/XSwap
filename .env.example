# WalletConnect Cloud project id (https://cloud.walletconnect.com) — optional.
# When set, "WalletConnect" appears in the connect dialog and works via QR / deep link.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional JSON-RPC overrides. Keyless public endpoints are the default, so these
# are only needed if you want a dedicated (faster, higher-rate-limit) endpoint.
VITE_RPC_ETHEREUM=
VITE_RPC_ARBITRUM=
VITE_RPC_BASE=
VITE_RPC_OPTIMISM=
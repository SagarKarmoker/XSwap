/**
 * Generates `src/config/token-logos.ts`.
 *
 * Logo provenance, in priority order:
 *   1. CoinGecko token list entry for the exact (chain, address) pair
 *   2. Uniswap's default token list entry (Ethereum)
 *   3. trustwallet/assets path for the checksummed address
 *
 * Only URLs that actually return an image are kept, so the UI never shows a
 * broken image. Anything missing falls back to the drawn monogram.
 *
 *   pnpm tokens:logos
 */
import { writeFile } from 'node:fs/promises'
import { getAddress } from 'viem'
import { listTokens, type XToken } from '../src/config/tokens'

const CG_SLUG: Record<number, string> = {
  1: 'ethereum',
  42161: 'arbitrum',
  8453: 'base',
  10: 'optimistic-ethereum',
}

async function json<T>(url: string): Promise<T | null> {
  try {
    const res = await fetch(url)
    return res.ok ? ((await res.json()) as T) : null
  } catch {
    return null
  }
}

type ListEntry = { chainId?: number; address: string; symbol: string; logoURI?: string; logoUri?: string }
type List = { tokens: ListEntry[] }

const [uniswapList, cgEthereum, cgArbitrum, cgBase, cgOptimism] = await Promise.all([
  json<List>('https://tokens.uniswap.org'),
  json<List>('https://tokens.coingecko.com/ethereum/all.json'),
  json<List>('https://tokens.coingecko.com/arbitrum/all.json'),
  json<List>('https://tokens.coingecko.com/base/all.json'),
  json<List>('https://tokens.coingecko.com/optimistic-ethereum/all.json'),
])

const byChain: Record<number, ListEntry[]> = {
  1: [...(uniswapList?.tokens ?? []), ...(cgEthereum?.tokens ?? [])],
  42161: cgArbitrum?.tokens ?? [],
  8453: cgBase?.tokens ?? [],
  10: cgOptimism?.tokens ?? [],
}

const slugByChain: Record<number, string> = {
  1: 'ethereum',
  42161: 'arbitrum',
  8453: 'base',
  10: 'optimistic-ethereum',
}

async function isImage(url: string | undefined): Promise<boolean> {
  if (!url) return false
  try {
    const res = await fetch(url, { headers: { range: 'bytes=0-1' } })
    if (!res.ok) return false
    const type = res.headers.get('content-type') ?? ''
    return type.startsWith('image/')
  } catch {
    return false
  }
}

function trustwalletUrl(chainId: number, checksummed: string): string {
  return `https://raw.githubusercontent.com/trustwallet/assets/master/blockchains/${slugByChain[chainId]}/assets/${checksummed}/logo.png`
}

const chains = [1, 42161, 8453, 10] as const
const result: Record<string, string> = {}
const missing: XToken[] = []

for (const chainId of chains) {
  const entries = byChain[chainId]
  const tokens = listTokens(chainId)

  for (const token of tokens) {
    const checksummed = getAddress(token.address.toLowerCase())
    const match = entries?.find((entry) => entry.address.toLowerCase() === token.address.toLowerCase())

    const candidates = [
      match?.logoURI ?? match?.logoUri,
      match ? trustwalletUrl(chainId, checksummed) : undefined,
      trustwalletUrl(chainId, checksummed),
    ]

    let resolved: string | undefined
    for (const candidate of candidates) {
      if (await isImage(candidate)) {
        resolved = candidate
        break
      }
    }

    if (resolved) {
      result[`${chainId}:${token.address.toLowerCase()}`] = resolved
    } else {
      missing.push(token)
    }
  }
}

const header = `/**
 * Token logos, keyed by \`chainId:address\`.
 *
 * AUTO-GENERATED by \`pnpm tokens:logos\` — do not edit by hand. Every URL was
 * confirmed to return an image at generation time; missing entries fall back to
 * the drawn monogram, so nothing renders broken.
 *
 * Sources: CoinGecko token lists, Uniswap's default token list, trustwallet/assets.
 */
export const tokenLogos: Record<string, string> = {
`

const body = Object.entries(result)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([key, url]) => `  '${key}':\n    '${url}',`)
  .join('\n')

await writeFile(
  new URL('../src/config/token-logos.ts', import.meta.url),
  `${header}${body}\n}\n`,
  'utf8',
)

console.log(`wrote ${Object.keys(result).length} logos`)
if (missing.length > 0) {
  console.log(`no logo found for ${missing.length} token(s):`)
  for (const token of missing) console.log(`  ${token.chainId} ${token.symbol} ${token.address}`)
}
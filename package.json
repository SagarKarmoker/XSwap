{
  "name": "xswap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "XSwap — swap any X token for any Y token. Vite + React + TS + Tailwind v4 + viem.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:deployments": "tsx --tsconfig tsconfig.app.json scripts/check-deployments.mts",
    "tokens:logos": "tsx --tsconfig tsconfig.app.json scripts/fetch-token-logos.mts"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@tanstack/react-query": "^5.104.3",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.55",
    "wagmi": "^3.7.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}